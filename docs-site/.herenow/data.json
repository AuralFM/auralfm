{
  "collections": {
    "claims": {
      "fields": {
        "station": {
          "type": "string",
          "required": true,
          "maxLength": 200,
          "trim": true
        },
        "station_id": {
          "type": "string",
          "maxLength": 100,
          "trim": true
        },
        "name": {
          "type": "string",
          "required": true,
          "maxLength": 120,
          "trim": true
        },
        "email": {
          "type": "email",
          "required": true,
          "maxLength": 254,
          "trim": true
        },
        "role": {
          "type": "string",
          "required": true,
          "maxLength": 24,
          "trim": true
        },
        "site": {
          "type": "string",
          "maxLength": 300,
          "trim": true
        },
        "lightning": {
          "type": "string",
          "maxLength": 120,
          "trim": true
        },
        "donate": {
          "type": "string",
          "maxLength": 300,
          "trim": true
        },
        "description": {
          "type": "string",
          "maxLength": 600,
          "trim": true
        },
        "links": {
          "type": "string",
          "maxLength": 800,
          "trim": true
        },
        "note": {
          "type": "string",
          "maxLength": 500,
          "trim": true
        },
        "age": {
          "type": "string",
          "maxLength": 8,
          "trim": true
        }
      },
      "access": {
        "read": "owner",
        "insert": "public",
        "update": "owner",
        "delete": "owner"
      },
      "rateLimit": "5/hour/ip"
    }
  }
}
