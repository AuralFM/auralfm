{
  "name": "auralfm",
  "version": "0.1.0",
  "description": "Listen to any live radio station in the world from your menu bar",
  "license": "Apache-2.0",
  "main": "src/main.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "catalogue": "node scripts/catalogue.mjs",
    "icons": "electron scripts/make-icons.js",
    "vendor": "node scripts/vendor.mjs && node scripts/lights.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "dist": "npm run vendor && npm run notices && npm run icons && node scripts/pack-data.mjs && node scripts/audit.mjs --release && electron-builder --mac",
    "sky": "node scripts/sky.mjs",
    "audit": "node scripts/audit.mjs",
    "web": "node scripts/build-web.mjs",
    "web:serve": "node scripts/serve-web.mjs",
    "crawl:sdr": "node scripts/crawl-sdr.mjs",
    "schedule": "node scripts/fetch-schedule.mjs",
    "lights": "node scripts/lights.mjs",
    "relays": "node scripts/relays.mjs",
    "sync-kb": "node scripts/sync-kb.mjs",
    "notices": "node scripts/notices.mjs",
    "capture": "node scripts/capture.mjs",
    "mail": "node scripts/mail.mjs",
    "errors": "node scripts/errors.mjs",
    "dist:staging": "npm run audit && npm run dist -- --config.extraMetadata.buildChannel=staging",
    "dist:beta": "npm run audit && npm run dist -- --config.extraMetadata.buildChannel=beta",
    "dist:prod": "npm run audit && npm run dist",
    "release": "node scripts/release.mjs",
    "test:relays": "node scripts/relay-test/two-party.mjs",
    "test:app-inbound": "node scripts/relay-test/app-inbound.mjs"
  },
  "devDependencies": {
    "electron": "^43.8.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "globe.gl": "^2.46.2",
    "qrcode-generator": "^2.0.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AuralFM/auralfm.git"
  },
  "homepage": "https://github.com/AuralFM/auralfm",
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "hls.js": "^1.7.4",
    "satellite.js": "^7.1.0"
  },
  "build": {
    "appId": "com.meltonbell.auralfm",
    "productName": "AuralFM",
    "copyright": "Copyright © 2026 Melton Bell",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/generated/**/*",
      "assets/tray/*.png",
      "assets/*.svg",
      "assets/fonts/**/*",
      "assets/ATTRIBUTION.md",
      "THIRD-PARTY-NOTICES.md",
      "LICENSE",
      "NOTICE",
      "package.json",
      "data/packed/**/*",
      "data/sdr.min.json",
      "docs/PRIVACY.md",
      "docs/TERMS.md",
      "docs/CODE-OF-CONDUCT.md",
      "assets/sky.json",
      "data/schedule.json",
      "data/relays.json",
      "data/hidden-shows.json",
      "data/filter-default.json",
      "!**/*.js.map",
      "!**/*.d.ts",
      "!**/*.d.ts.map",
      "!**/*.ts",
      "!node_modules/satellite.js/wasm-build/**",
      "!node_modules/@noble/*/src/**",
      "!assets/generated/app-1024.png",
      "!src/renderer/vendor/lite/**"
    ],
    "mac": {
      "electronLanguages": [
        "en",
        "en_GB",
        "es",
        "es_419",
        "fr",
        "de",
        "pt_BR",
        "pt_PT"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "AuralFM uses the microphone only when you turn it on in Your show, to go live.",
        "NSLocalNetworkUsageDescription": "AuralFM connects to a listener on your own network only when you are live in Your show and they press Listen.",
        "NSAudioCaptureUsageDescription": "AuralFM takes this computer's sound only when you choose it as your show's music in Your show.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.meltonbell.auralfm",
            "CFBundleURLSchemes": [
              "auralfm"
            ]
          }
        ]
      }
    },
    "dmg": {
      "title": "AuralFM ${version}"
    }
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
