{
  "name": "globefm",
  "version": "0.1.0",
  "description": "Listen to any live radio station in the world from your menu bar",
  "main": "src/main.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "crawl": "node scripts/crawl.mjs",
    "icons": "electron scripts/make-icons.js",
    "tags": "node --max-old-space-size=4096 scripts/tags.mjs",
    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "dist": "npm run vendor && npm run icons && electron-builder --mac",
    "check": "node scripts/crawl.mjs --check",
    "sky": "node scripts/sky.mjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git"
  },
  "homepage": "https://github.com/YOUR_USERNAME/globefm",
  "dependencies": {
    "globe.gl": "^2.46.1"
  },
  "build": {
    "appId": "com.meltonbell.globefm",
    "productName": "GlobeFM",
    "copyright": "Copyright \u00a9 2026 Melton Bell",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/generated/**/*",
      "assets/*.svg",
      "assets/ATTRIBUTION.md",
      "package.json",
      "data/stations.min.json",
      "assets/sky.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.meltonbell.globefm",
            "CFBundleURLSchemes": [
              "globefm"
            ]
          }
        ]
      }
    },
    "dmg": {
      "title": "GlobeFM ${version}"
    }
  }
}