{
  "name": "auralfm",
  "version": "0.1.0",
  "description": "Listen to any live radio station in the world from your menu bar",
  "license": "MIT",
  "main": "src/main.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "crawl": "node scripts/crawl.mjs",
    "icons": "electron scripts/make-icons.js",
    "tags": "node --max-old-space-size=4096 scripts/tags.mjs",
    "vendor": "node scripts/vendor.mjs && node scripts/lights.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "dist": "npm run vendor && npm run notices && npm run icons && electron-builder --mac",
    "check": "node scripts/crawl.mjs --check",
    "sky": "node scripts/sky.mjs",
    "audit": "node scripts/audit.mjs",
    "crawl:sdr": "node scripts/crawl-sdr.mjs",
    "schedule": "node scripts/fetch-schedule.mjs",
    "lights": "node scripts/lights.mjs",
    "relays": "node scripts/relays.mjs",
    "sync-kb": "node scripts/sync-kb.mjs",
    "notices": "node scripts/notices.mjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "globe.gl": "^2.46.1"
  },
  "repository": {
    "type": "git"
  },
  "homepage": "https://github.com/YOUR_USERNAME/auralfm",
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "satellite.js": "^7.1.0"
  },
  "build": {
    "appId": "com.meltonbell.auralfm",
    "productName": "AuralFM",
    "copyright": "Copyright \u00a9 2026 Melton Bell",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/generated/**/*",
      "assets/tray/*.png",
      "assets/*.svg",
      "assets/fonts/**/*",
      "assets/ATTRIBUTION.md",
      "THIRD-PARTY-NOTICES.md",
      "package.json",
      "data/stations.min.json",
      "data/sdr.min.json",
      "docs/PRIVACY.md",
      "docs/TERMS.md",
      "CODE_OF_CONDUCT.md",
      "CONTRIBUTING.md",
      "docs/CAPTIONS.md",
      "docs/DECENTRALIZATION.md",
      "docs/RECEIVERS.md",
      "assets/sky.json",
      "data/schedule.json",
      "data/relays.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "com.meltonbell.auralfm",
            "CFBundleURLSchemes": [
              "auralfm"
            ]
          }
        ]
      }
    },
    "dmg": {
      "title": "AuralFM ${version}"
    }
  }
}
